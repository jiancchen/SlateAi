  "distribution_bridge_policy": {
    "props_are_distribution_contracts": true,
    "no_isolated_prop_models": true,
    "required_consistency": [
      "hitter props consume player PA/event/stat distributions",
      "starter props consume starter state/stat and starter-exit distributions",
      "first-up relief routing consumes starter-exit and reliever-availability distributions",
      "reliever props consume relief-chain and reliever stat distributions",
      "game and team markets consume shared run/game-shape, starter-exit, reliever-availability, and relief-chain distributions",
      "hitter props consume one opponent pitching path with starter-phase and reliever-chain PA/event mix distributions"
    ]
  },
  "required_report_fields": [
