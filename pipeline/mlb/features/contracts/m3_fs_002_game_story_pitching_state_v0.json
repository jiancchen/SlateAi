{
  "as_of_policy": "pregame",
  "description": "First real MLB-M3 game-grain feature set with replay/story memory, starter path, reliever-chain, hitter-path coverage, and game-shape precursor features.",
  "evidence_policy": {
    "baseline_layers": [
      "cumulative_prior_season",
      "ordered_prior_game_state",
      "days_since_event",
      "current_run_length",
      "coverage_and_low_data_flags"
    ],
    "evidence_policy_id": "m3_no_fixed_window_truth_v1",
    "evidence_units": [
      "prior_game",
      "prior_start",
      "prior_pitcher_appearance",
      "pregame_snapshot",
      "lineup_slot",
      "pitch_type_surface"
    ],
    "forbidden": [
      "sports.db reads",
      "M2 generated artifacts",
      "hand-coded betting scores",
      "expected AB as input truth",
      "fixed raw windows as form truth"
    ],
    "required_coverage_fields": [
      "sample_count",
      "event_count",
      "availability_flag",
      "missingness_rate",
      "snapshot_age_days"
    ],
    "state_memory_encoders": [
      "days_since_event",
      "current_run_length",
      "ordered_last_event",
      "cumulative_event_rate",
      "alternation_rate",
      "low_data_flag",
      "reaction_to_prior_performance"
    ]
  },
  "feature_families": [
    "replay_story_memory",
    "starter_workload_path",
    "starter_exit_hazard",
    "starter_pitch_mix_surface",
    "starter_mistake_shape_surface",
    "reliever_availability_reset",
